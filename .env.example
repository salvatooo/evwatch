# Copy this file to .env and fill in your own values. Never commit .env.

TZ=Asia/Singapore

# ---- Telegram (required to use /arm, /find and /add)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- LTA DataMall (free key from https://datamall.lta.gov.sg)
LTA_ACCOUNT_KEY=
# true also tracks every postal code listed below. Locations added with /add work either way.
USE_LTA=false
POSTAL_CODES=

# ---- Charge+ (your own account)
USE_CHARGEPLUS=true
# The x-api-key header the Charge+ app sends when it signs in
CHARGEPLUS_API_KEY=
CHARGEPLUS_PHONE_IDD=+65
CHARGEPLUS_PHONE=
CHARGEPLUS_PASSWORD=
# Or keep the password in a file under ./data and set this instead, e.g. /data/chargeplus_password.txt
CHARGEPLUS_PASSWORD_FILE=
# Optional: comma-separated status URLs to load on the very first start. /add is usually easier.
CHARGEPLUS_URL=

# ---- Filters (leave empty unless needed)
OPERATOR=
PLUG_TYPES=
CURRENT=
MIN_KW=0
STATION_FILTER=

# ---- Behaviour
# Minimum is 120. Polling faster can get your account blocked.
POLL_SECONDS=120
# manual = watch with /arm; always = watch every location all the time
MODE=manual
ARM_DEFAULT_MINUTES=180
# always mode only, e.g. 07-23
ACTIVE_HOURS=
NOTIFY_ON_FINISHING=true
NOTIFY_ON_TAKEN=true

# ---- Optional extra notifications
NTFY_URL=
WEBHOOK_URL=
